---
import Base from './Base.astro';
import Infobox from '../components/Infobox.astro';
import SourceList from '../components/SourceList.astro';
import { SITE, CATEGORY_BY_SLUG } from '../site.config.js';

const { entry, category } = Astro.props;
const d = entry.data;
const cat = CATEGORY_BY_SLUG[category];

const fmt = (date: Date) =>
  new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(date);

const SCHEMA_TYPE: Record<string, string> = {
  School: 'EducationalOrganization',
  University: 'CollegeOrUniversity',
  College: 'CollegeOrUniversity',
  Person: 'Person',
  Organization: 'Organization',
  TrainStation: 'TrainStation',
  ReligiousSite: 'PlaceOfWorship',
  Hospital: 'Hospital',
  Place: 'Place',
};

const pageUrl = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;

// Only evidenced fields go into structured data.
const entityLd: Record<string, unknown> = {
  '@type': SCHEMA_TYPE[d.entityType] ?? 'Thing',
  name: d.title,
  description: d.summary,
  url: pageUrl,
};
if (d.location || d.country) {
  entityLd.address = { '@type': 'PostalAddress', addressLocality: d.location, addressCountry: d.country };
}
if (d.established) entityLd.foundingDate = d.established;
const officialSite = d.sources.find((s: any) => s.tier === 'first-party');
if (officialSite) entityLd.sameAs = [officialSite.url];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    entityLd,
    {
      '@type': 'Article',
      headline: d.title,
      description: d.summary,
      datePublished: d.published.toISOString(),
      dateModified: d.lastUpdated.toISOString(),
      author: { '@type': 'Person', name: d.author, url: `${SITE.url}/about/roksana/` },
      publisher: { '@type': 'Organization', name: SITE.publisher, url: SITE.url },
      mainEntityOfPage: pageUrl,
      about: entityLd,
      citation: d.sources.map((s: any) => ({ '@type': 'CreativeWork', name: s.title, url: s.url })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
        { '@type': 'ListItem', position: 2, name: cat.label, item: `${SITE.url}/${category}/` },
        { '@type': 'ListItem', position: 3, name: d.title, item: pageUrl },
      ],
    },
  ],
};

const facts = [
  ...(d.established ? [{ label: 'Established', value: d.established }] : []),
  ...(d.location ? [{ label: 'Location', value: d.location }] : []),
  { label: 'Country', value: d.country },
  ...d.facts,
];

const tierCount = (t: string) => d.sources.filter((s: any) => s.tier === t).length;
---

<Base title={d.title} description={d.summary} jsonLd={jsonLd}>
  <div class="wrap">
    <p class="breadcrumb">
      <a href="/">Home</a> › <a href={`/${category}/`}>{cat.label}</a> › {d.title}
    </p>

    <div class="profile">
      <div>
        <h1>{d.title}</h1>
        <p class="lede">{d.summary}</p>

        <div class="note" style="margin-top:1.75rem">
          <p>
            <strong>Source quality.</strong> This profile cites {d.sources.length} source{d.sources.length === 1 ? '' : 's'}
            ({tierCount('tier1')} tier&nbsp;1, {tierCount('tier2')} tier&nbsp;2, {tierCount('tier3')} tier&nbsp;3,
            {' '}{tierCount('first-party')} first-party). Claims made by the subject about itself are marked
            <span class="fp">first-party</span> and are not presented as independent evidence.
            See our <a href="/about/source-policy/">source policy</a>.
          </p>
          {d.sourceNote && <p>{d.sourceNote}</p>}
        </div>

        <div class="prose">
          <slot />
        </div>

        {d.timeline.length > 0 && (
          <>
            <h2 id="timeline">Timeline</h2>
            <div class="table-scroll">
              <table>
                <thead>
                  <tr><th scope="col">Year</th><th scope="col">Documented event</th><th scope="col">Source type</th></tr>
                </thead>
                <tbody>
                  {d.timeline.map((t: any) => (
                    <tr><td>{t.year}</td><td>{t.event}</td><td>{t.sourceType ?? '—'}</td></tr>
                  ))}
                </tbody>
              </table>
            </div>
          </>
        )}

        {d.openItems.length > 0 && (
          <>
            <h2 id="open-items">Open items</h2>
            <div class="note note--flag">
              <p style="margin-bottom:0.6rem">
                <strong>Claims we could not verify.</strong> These are recorded openly rather than published as fact or
                quietly dropped. If you hold a source that settles one, please
                <a href="/about/corrections/"> tell us</a>.
              </p>
              <ul style="margin:0; padding-left:1.2rem">
                {d.openItems.map((item: string) => <li>{item}</li>)}
              </ul>
            </div>
          </>
        )}

        <h2 id="sources">Sources</h2>
        <SourceList sources={d.sources} />

        {d.related.length > 0 && (
          <>
            <h2 id="related">Related entities</h2>
            <ul>
              {d.related.map((r: any) => <li><a href={r.href}>{r.label}</a></li>)}
            </ul>
          </>
        )}

        <h2 id="about-this-profile">About this profile</h2>
        <p>
          Written by <a href="/about/roksana/">{d.author}</a> — Research &amp; Editorial.
          Published {fmt(d.published)}. Last updated {fmt(d.lastUpdated)}.
        </p>
        <p style="font-size:0.95rem; color:var(--ink-soft)">
          Every factual claim above is linked to the source it rests on. {SITE.name} is not affiliated with
          {' '}{d.title}. If you can document an error, see our <a href="/about/corrections/">corrections policy</a>.
        </p>
      </div>

      <div class="profile__aside">
        <Infobox title={d.title} entityType={d.entityType} facts={facts} />
      </div>
    </div>
  </div>
</Base>
