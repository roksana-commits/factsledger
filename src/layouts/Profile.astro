---
import Base from './Base.astro';
import KeyFacts from '../components/KeyFacts.astro';
import SourceList from '../components/SourceList.astro';
import { SITE, CATEGORY_BY_SLUG } from '../site.config.js';

const { entry, category } = Astro.props;
const d = entry.data;
const cat = CATEGORY_BY_SLUG[category];

const fmt = (date: Date) =>
  new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(date);

const SCHEMA_TYPE: Record<string, string> = {
  School: 'School',
  University: 'CollegeOrUniversity',
  College: 'CollegeOrUniversity',
  Person: 'Person',
  Organization: 'Organization',
  TrainStation: 'TrainStation',
  ReligiousSite: 'PlaceOfWorship',
  Hospital: 'Hospital',
  Place: 'Place',
};

const pageUrl = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;

// Only evidenced fields go into structured data.
const entityLd: Record<string, unknown> = {
  '@type': SCHEMA_TYPE[d.entityType] ?? 'Thing',
  name: d.title,
  description: d.summary,
  url: pageUrl,
};
if (d.location || d.country) {
  entityLd.address = { '@type': 'PostalAddress', addressLocality: d.location, addressCountry: d.country };
}
if (d.established) entityLd.foundingDate = d.established;
const officialSite = d.sources.find((s: any) => s.tier === 'first-party');
if (officialSite) entityLd.sameAs = [officialSite.url];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    entityLd,
    {
      '@type': 'Article',
      headline: d.title,
      description: d.summary,
      datePublished: d.published.toISOString(),
      dateModified: d.lastUpdated.toISOString(),
      author: { '@type': 'Person', name: d.author, url: `${SITE.url}/about/${SITE.author.slug}/` },
      publisher: { '@type': 'Organization', name: SITE.publisher, url: SITE.url },
      mainEntityOfPage: pageUrl,
      about: entityLd,
      citation: d.sources.map((s: any) => ({ '@type': 'CreativeWork', name: s.title, url: s.url })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
        { '@type': 'ListItem', position: 2, name: cat.label, item: `${SITE.url}/${category}/` },
        { '@type': 'ListItem', position: 3, name: d.title, item: pageUrl },
      ],
    },
  ],
};

const facts = [
  ...(d.established ? [{ label: 'Established', value: d.established }] : []),
  ...(d.location ? [{ label: 'Location', value: d.location }] : []),
  { label: 'Country', value: d.country },
  ...d.facts,
];

const TIER_NAMES: Record<string, string> = {
  tier1: 'tier 1',
  tier2: 'tier 2',
  tier3: 'tier 3',
  'first-party': 'first-party',
};
const tierBreakdown = Object.entries(TIER_NAMES)
  .map(([key, label]) => [d.sources.filter((s: any) => s.tier === key).length, label] as const)
  .filter(([count]) => count > 0)
  .map(([count, label]) => `${count} ${label}`)
  .join(', ');
const hasFirstParty = d.sources.some((s: any) => s.tier === 'first-party');
---

<Base title={d.title} description={d.summary} jsonLd={jsonLd}>
  <article class="wrap article">
    <p class="kicker"><a href={`/${category}/`}>{cat.label}</a></p>

    <h1>{d.title}</h1>
    <p class="lede">{d.summary}</p>

    <p class="byline">
      Researched by <a href={`/about/${SITE.author.slug}/`}>{d.author}</a> · {fmt(d.published)}
      {d.lastUpdated.valueOf() !== d.published.valueOf() && <> · updated {fmt(d.lastUpdated)}</>}
    </p>

    <KeyFacts facts={facts} />

    <div class="prose">
      <slot />
    </div>

    {d.timeline.length > 0 && (
      <>
        <h2 id="timeline">Timeline</h2>
        <dl class="timeline">
          {d.timeline.map((t: any) => (
            <>
              <dt>{t.year}</dt>
              <dd>{t.event}</dd>
            </>
          ))}
        </dl>
      </>
    )}

    {d.openItems.length > 0 && (
      <>
        <h2 id="open-items">What we could not verify</h2>
        <p>
          These claims came up in research and could not be confirmed. They are recorded here rather than published
          as fact or quietly dropped. If you hold a source that settles one,
          <a href="/about/corrections/"> please tell us</a>.
        </p>
        <ul>
          {d.openItems.map((item: string) => <li>{item}</li>)}
        </ul>
      </>
    )}

    <h2 id="sources">Sources</h2>
    <p class="note-line">
      {d.sources.length} source{d.sources.length === 1 ? '' : 's'} ({tierBreakdown}), each opened and read against
      the claim it supports.
      {hasFirstParty
        ? ' Statements the subject makes about itself are marked as such and are not treated as independent evidence.'
        : ' Every source is independent of the subject; no first-party material is cited.'}
      {' '}See the <a href="/about/source-policy/">source policy</a>.
    </p>
    {d.sourceNote && <p class="note-line">{d.sourceNote}</p>}
    <SourceList sources={d.sources} />

    {d.related.length > 0 && (
      <>
        <h2 id="related">Related</h2>
        <ul>
          {d.related.map((r: any) => <li><a href={r.href}>{r.label}</a></li>)}
        </ul>
      </>
    )}

    <footer class="article__footer">
      <p>
        Researched and written by <a href={`/about/${SITE.author.slug}/`}>{d.author}</a>.
        Published {fmt(d.published)}; last updated {fmt(d.lastUpdated)}.
      </p>
      <p>
        Every factual claim above is linked to the source it rests on. {SITE.name} is not affiliated with
        {' '}{d.title}. If you can document an error, see our <a href="/about/corrections/">corrections policy</a>.
      </p>
    </footer>
  </article>
</Base>
