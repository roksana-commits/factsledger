---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE, CATEGORIES } from '../site.config.js';

const all = [];
for (const cat of CATEGORIES) {
  const entries = await getCollection(cat.collection as any);
  for (const e of entries as any[]) {
    if (!e.data.draft) all.push({ ...e, category: cat.slug, categoryLabel: cat.label });
  }
}
all.sort((a, b) => b.data.lastUpdated.valueOf() - a.data.lastUpdated.valueOf());
const recent = all.slice(0, 12);

const fmt = (d: Date) =>
  new Intl.DateTimeFormat('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(d);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  publisher: { '@type': 'Organization', name: SITE.publisher, url: SITE.url },
};
---

<Base title={SITE.name} jsonLd={jsonLd}>
  <div class="wrap wrap--centred">
    <div class="narrow">
      <p class="eyebrow">Independent reference profiles</p>
      <h1>Documented entities. Independent sources. Clear context.</h1>
      <p class="lede">
        {SITE.name} publishes research-backed profiles of schools, universities, people, organizations, places and
        species, compiled from government records, institutional publications and independent reporting. Every claim is linked
        to the source it rests on, and first-party statements are labelled as such.
      </p>
      <p style="font-family:var(--font-ui); font-size:0.9rem; margin-top:1.25rem">
        <a href="/about/methodology/">How we research</a> ·
        <a href="/about/source-policy/">What we cite</a> ·
        <a href="/about/corrections/">How to correct us</a>
      </p>
    </div>

    <h2 style="margin-top:3.5rem">Browse by category</h2>
    <ul class="cards">
      {CATEGORIES.map((c) => (
        <li class="card">
          <h3><a href={`/${c.slug}/`}>{c.label}</a></h3>
          <p>{c.blurb}</p>
        </li>
      ))}
    </ul>

    <div class="section-heading" style="margin-top:3rem">
      <h2>Recently researched</h2>
      {recent[0] && <span>Updated {fmt(recent[0].data.lastUpdated)}</span>}
    </div>
    {recent.length === 0 ? (
      <p style="color:var(--ink-soft)">No profiles published yet.</p>
    ) : (
      <ul class="index-list">
        {recent.map((e: any) => (
          <li class="index-list__row">
            <div class="index-list__content">
              <a href={`/${e.category}/${e.id}/`}>{e.data.title}</a>
              <p>{e.data.summary}</p>
            </div>
            <aside class="index-list__aside" aria-label={`${e.data.title} metadata`}>
              <strong>{e.categoryLabel}</strong>
              <span>{e.data.country}</span>
              <span>{e.data.sources.length} sources</span>
              <time datetime={e.data.lastUpdated.toISOString()}>{fmt(e.data.lastUpdated)}</time>
            </aside>
          </li>
        ))}
      </ul>
    )}

    <div class="home-panels">
      <section class="home-panel home-panel--plain">
        <h2>What this site is not</h2>
        <p>
          {SITE.name} is not an encyclopedia and does not reproduce content from one. Profiles are researched
          independently from primary and published sources. Where a claim cannot be verified, it is listed openly as an
          open item rather than published as fact.
        </p>
      </section>
      <section class="home-panel home-panel--support" id="support">
        <h2>Support the research</h2>
        <p>
          Every profile takes careful source-reading before publication. If you would like to support the research and
          website maintenance, contact us to discuss it.
        </p>
        <a class="btn-donate" href={`mailto:${SITE.email}?subject=Support%20FactsLedger`}>Donate</a>
      </section>
    </div>
  </div>
</Base>
