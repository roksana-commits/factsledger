---
interface Fact { label: string; value: string; firstParty?: boolean }
interface Props { title: string; entityType: string; facts: Fact[] }
const { title, entityType, facts } = Astro.props;

const TYPE_LABEL: Record<string, string> = {
  School: 'School',
  University: 'University',
  College: 'College',
  Person: 'Person',
  Organization: 'Organization',
  TrainStation: 'Railway station',
  ReligiousSite: 'Religious site',
  Hospital: 'Hospital',
  Place: 'Place',
};
---

<aside class="infobox" aria-label={`Key facts about ${title}`}>
  <div class="infobox__head">
    <h2>{title}</h2>
    <p>{TYPE_LABEL[entityType] ?? entityType}</p>
  </div>
  <dl>
    {facts.map((f) => (
      <div>
        <dt>{f.label}</dt>
        <dd>
          {f.value}
          {f.firstParty && <span class="fp" title="Stated by the subject about itself">first-party</span>}
        </dd>
      </div>
    ))}
  </dl>
</aside>
