---
---

<aside class="ad-banner" aria-label="Advertisement">
  <p class="ad-banner__label">Advertisement</p>
  <div class="ad-banner__frame">
    <script is:inline>
      atOptions = {
        'key' : 'fd7eed3b26537030dbb97d843736793a',
        'format' : 'iframe',
        'height' : 50,
        'width' : 320,
        'params' : {}
      };
    </script>
    <script
      is:inline
      src="https://www.highrevenueformat.com/fd7eed3b26537030dbb97d843736793a/invoke.js"
    ></script>
    <script is:inline>
      (() => {
        const currentScript = document.currentScript;
        const banner = currentScript?.closest('.ad-banner');
        const frame = banner?.querySelector('.ad-banner__frame');
        if (!banner || !frame) return;
        window.setTimeout(() => {
          const renderedAd = frame.querySelector('iframe, img, video, object, embed, ins, a');
          if (!renderedAd && frame.childElementCount === 0) banner.remove();
        }, 2500);
      })();
    </script>
  </div>
</aside>

<style>
  .ad-banner {
    display: flex;
    width: min(100%, 320px);
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    margin: 1.5rem auto 1.75rem;
  }
  .ad-banner__label {
    margin: 0;
    color: var(--muted, #6d6a63);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
  }
  .ad-banner__frame {
    display: flex;
    width: 320px;
    min-height: 50px;
    max-width: 100%;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  @media (max-width: 360px) {
    .ad-banner {
      width: 100%;
    }
    .ad-banner__frame {
      transform-origin: top center;
    }
  }
</style>
